{
  "schemaVersion": 1,
  "commands": {
    "build": {
      "executable": "runghc",
      "arguments": [
        "tools/Build.hs"
      ],
      "timeoutSeconds": 60
    },
    "test": {
      "executable": "cabal",
      "arguments": [
        "test",
        "fixture-test",
        "--offline",
        "-j1",
        "--test-show-details=direct"
      ],
      "timeoutSeconds": 30
    }
  },
  "cases": [
    {
      "id": "generated-guard",
      "description": "Mutate generator input before generation so the compiled guard is removed.",
      "edits": [
        {
          "kind": "replace",
          "path": "model.txt",
          "old": "mode=strict",
          "new": "mode=open"
        }
      ],
      "build": "build",
      "test": "test",
      "expect": {
        "kind": "diagnostic",
        "stage": "test",
        "exitCode": 1,
        "outputContains": "generated capacity: FAIL"
      }
    }
  ]
}
