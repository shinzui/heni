{
  "schemaVersion": 1,
  "sourceRoot": ".",
  "commands": {
    "build": {
      "executable": "heni-hspec-fixture",
      "arguments": [
        "--heni-build"
      ]
    },
    "test": {
      "executable": "heni-hspec-fixture"
    }
  },
  "cases": [
    {
      "id": "property",
      "description": "Detect the intended assertion",
      "adapter": "heni-v1",
      "edits": [
        {
          "kind": "replace",
          "path": "input",
          "old": "anchor",
          "new": "property"
        }
      ],
      "build": "build",
      "test": "test",
      "expect": {
        "kind": "named-tests",
        "failures": [
          "suite/property"
        ],
        "replayRequired": true
      },
      "selector": "property"
    }
  ]
}
