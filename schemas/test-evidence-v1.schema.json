{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shinzui/heni/master/schemas/test-evidence-v1.schema.json",
  "title": "Heni test-evidence v1 JSON Lines record",
  "description": "Each line is one record; the core additionally validates attempt identity, sequence, lifecycle, membership and completion counts.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "stage": {
          "enum": [
            "setup",
            "build",
            "test",
            "replay",
            "teardown"
          ]
        },
        "role": {
          "enum": [
            "baseline",
            "candidate"
          ]
        },
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "begin"
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1
        },
        "discoveredIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "protocolVersion",
        "runId",
        "caseId",
        "stage",
        "role",
        "attempt",
        "sequence",
        "kind",
        "producerVersion",
        "discoveredIds",
        "selectedIds"
      ],
      "additionalProperties": false
    },
